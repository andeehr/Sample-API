{
  "ConnectionStrings": {
    "DataContext": "Server=${MS_HOST};Database=${MS_DATABASE};User Id=${MS_USER};Password=${MS_PASS};Encrypt=${MS_ENCRYPT};Trusted_Connection=${MS_TRUSTED};"
  },
  "JwtOptions": {
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpirationHours": "${JWT_EXPIRATION}",
    "Enabled": "${JWT_ENABLED}",
    "JwtKey": "${JWT_KEY}"
  },
  "FilterQueryOptions": {
    "LimitRows": "${LIMIT_ROWS}"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "${LOG_LEVEL}",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "${LOG_PATH}",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ],
    "Enrich": [
      "WithExceptionDetails"
    ],
    "Properties": {
      "Application": "Sample.Api"
    }
  }
}