{
  "ConnectionStrings": {
    "DataContext": "Server=${MS_HOST};Database=${MS_DATABASE};User Id=${MS_USER};Password=${MS_PASS};Encrypt=${MS_ENCRYPT};Trusted_Connection=${MS_TRUSTED};"
  },
  "JwtOptions": {
    "Issuer": "${JWT_ISSUER}",
    "Audience": "${JWT_AUDIENCE}",
    "ExpirationHours": "${JWT_EXPIRATION}",
    "Enabled": "${JWT_ENABLED}",
    "JwtKey": "${JWT_KEY}"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "${LOG_PATH}",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level}] {Message}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "Sample.Api"
    }
  }
}